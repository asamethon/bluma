{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "plugins/**/*.js",
    "goldie/*.config.ts",
    "scripts/**/*.{js,cjs}",
    "__tests__/support/**/*.ts"
  ],
  "project": [
    "**/*.{ts,tsx,js,cjs}",
    "!server/**"
  ],
  "ignoreBinaries": ["firebase"],
  "ignoreDependencies": ["expo-modules-jsi"]
}
