{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "plugins/**/*.js",
    "goldie/*.config.ts",
    "scripts/**/*.{js,cjs}"
  ],
  "project": [
    "**/*.{ts,tsx,js,cjs}",
    "!server/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignore": [
    "__tests__/support/chapterFirestore.ts"
  ],
  "ignoreDependencies": [
    "expo-modules-jsi"
  ],
  "ignoreBinaries": [
    "firebase"
  ]
}
