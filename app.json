{
  "expo": {
    "name": "bluma",
    "slug": "bluma",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bluma",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.asamethon.bluma",
      "usesAppleSignIn": true,
      "buildNumber": "13",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:bluma-dc10e.web.app"
      ],
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Sohbetlerde fotoğraf çekip gönderebilmen için kameraya erişim gerekir.",
        "NSPhotoLibraryUsageDescription": "Lansman görselini Instagram'da paylaşabilmek için fotoğraflarına erişim gerekir.",
        "NSPhotoLibraryAddUsageDescription": "Lansman görselini Instagram'da paylaşabilmek için fotoğraflarına ekleme izni gerekir.",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories"
        ]
      },
      "appleTeamId": "RUXJ98MZ8W",
      "appStoreUrl": "https://apps.apple.com/app/id6749180146?action=write-review"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.d4tecompany.bluma",
      "versionCode": 14,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.d4tecompany.bluma",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "bluma-dc10e.web.app", "pathPrefix": "/story" },
            { "scheme": "https", "host": "bluma-dc10e.web.app", "pathPrefix": "/user" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "./plugins/withFmtConstevalFix",
      "@react-native-firebase/auth",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-mark.png",
          "imageWidth": 132,
          "resizeMode": "contain",
          "backgroundColor": "#2A1B52"
        }
      ],
      "./plugins/withAndroidSplashBackgroundFix",
      "./plugins/withWriteTabIcon",
      "@sentry/react-native",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-localization",
      "expo-secure-store",
      [
        "react-native-share",
        {
          "ios": ["instagram", "instagram-stories"],
          "android": ["com.instagram.android"]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Sesli mesaj gönderebilmen için mikrofona erişim gerekir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "48225aed-f559-49db-af13-d65c9d2518f0"
      }
    }
  }
}
