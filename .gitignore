.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# Yalnızca KÖKTEKİ prebuild çıktıları. Sondaki eğik çizgiyle başlayan desen
# şart: `ios/` yazılırsa her seviyedeki ios klasörü — `modules/*/ios` dahil —
# göz ardı edilir ve yerel Expo modüllerinin native kodu build'e hiç gitmez.
/ios/
/android/
# env dosyaları (Sentry token vb. gizli bilgiler)
.env
.env.*
!.env.example

# Firebase Admin SDK servis hesabı anahtarı — ASLA commit'lenmez (gizli private_key)
firebase/
*-firebase-adminsdk-*.json

# Proje yarn kullanıyor; npm lockfile'ı yanlışlıkla oluşmasın
package-lock.json

# Bluma görsel servisi — yerel veri ve bağımlılıklar
server/data/

# Build çıktıları ve emülatör logları
*.aab
*.apk
*.ipa
firestore-debug.log

# goldie magaza gorselleri (uretilen ciktilar)
goldie/out/
goldie/goldie.design.json

# argent demo hesap kimlik bilgileri ({{secret:...}} yer tutucularinin kaynagi)
.argent/secrets.env
/.argent/recordings/

# goldie capture icin sabitlenen release simulator build'i
goldie/build/
