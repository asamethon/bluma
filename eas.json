{
  "cli": {
    "version": ">= 24.12.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    },
    "production-candidate": {
      "extends": "production",
      "distribution": "internal",
      "channel": "production-candidate",
      "autoIncrement": false
    }
  },
  "submit": {
    "production": {}
  }
}
