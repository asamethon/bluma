# Instagram Story paylaşımında bağlantı etiketi için Meta uygulama kimliği.
EXPO_PUBLIC_META_APP_ID=

# EAS ortamlarında sensitive/plaintext olmalı; secret OTA sırasında okunamaz.
EXPO_PUBLIC_SENTRY_DSN=
# Source map yüklemesi için yerel kabukta veya GitHub environment secrets içinde.
# Bu token istemciye eklenmez; native build için ota:setup-sentry kullanılır.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=asamethon
SENTRY_PROJECT=react-native
# Yalnızca CI/CLI için Expo robot token'ı; GitHub environment secret olarak tutulur.
EXPO_TOKEN=

# DM'lerde GIF ve çıkartma araması için KLIPY anahtarı (ücretsiz).
# https://klipy.com → Partner Panel → API Keys. Test kipinde saatte 100 istek;
# panelden "Production access" istenince sınır kalkıyor. Boşsa seçici gizlenir.
EXPO_PUBLIC_KLIPY_API_KEY=7xS2yDwqM5xucuuGm3Pm4eJx8lvg1hbRwEF6OEJ9HvpCZhAcYe9l5EoDmK5Coi2x
